{
  "uid": "aws-retail-lab",
  "title": "AWS Retail · 真实业务观测",
  "tags": [
    "aws-retail",
    "dotops-lab"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "服务采集状态",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"aws-retail\",service!=\"\"}",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Ubuntu CPU 使用率",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - avg(rate(node_cpu_seconds_total{job=\"aws-retail\",mode=\"idle\"}[2m])) * 100",
          "legendFormat": "{{service}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Ubuntu 内存使用率",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"aws-retail\"} / node_memory_MemTotal_bytes{job=\"aws-retail\"})",
          "legendFormat": "{{service}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "请求速率（Java 与商品服务）",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (rate(http_server_requests_seconds_count{job=\"aws-retail\",uri!~\"/actuator.*\"}[2m])) or sum by(service) (rate(gin_requests_total{job=\"aws-retail\",url!~\"/health|/metrics\"}[2m]))",
          "legendFormat": "{{service}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "平均请求耗时（Java 与商品服务）",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (rate(http_server_requests_seconds_sum{job=\"aws-retail\",uri!~\"/actuator.*\"}[2m])) / sum by(service) (rate(http_server_requests_seconds_count{job=\"aws-retail\",uri!~\"/actuator.*\"}[2m])) or sum by(service) (rate(gin_request_duration_seconds_sum{job=\"aws-retail\"}[2m])) / sum by(service) (rate(gin_request_duration_seconds_count{job=\"aws-retail\"}[2m]))",
          "legendFormat": "{{service}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "订单数据库连接池",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"aws-retail\",__name__=~\"hikaricp_connections_(active|idle|pending|max)\"}",
          "legendFormat": "{{service}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "JVM 堆内存",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (jvm_memory_used_bytes{job=\"aws-retail\",area=\"heap\"})",
          "legendFormat": "{{service}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "真实容器日志",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_namespace=\"aws-retail\"}",
          "legendFormat": "{{service}} {{__name__}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true
      }
    }
  ],
  "links": [
    {
      "title": "dotOps 链路页面",
      "url": "http://127.0.0.1:8080/aiops/tracing",
      "type": "link",
      "targetBlank": true
    },
    {
      "title": "商城",
      "url": "http://192.168.108.128:8888",
      "type": "link",
      "targetBlank": true
    }
  ],
  "description": "采集 Ubuntu 与商城真实指标、日志。请求速率与耗时面板覆盖 Java 和商品服务；checkout 的 HTTP 性能需在链路中查看。依赖和链路在 dotOps 或 Grafana Explore/Tempo 查询。"
}
